{
  "name": "goa-rover",
  "version": "1.0.0",
  "description": "In-situ developer guardian Chrome extension",
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "serve": "node serve.js"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverageFrom": [
      "extension/injected/**/*.js",
      "extension/lib/**/*.js",
      "!**/node_modules/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 60,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}
