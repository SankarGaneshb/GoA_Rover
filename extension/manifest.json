{
  "manifest_version": 3,
  "name": "GoA_Rover - On-the-Spot Developer Guardian",
  "version": "1.0.0",
  "description": "Zero-friction on-the-spot developer sidecar for web apps. Replaces DevTools, Postman, and React DevTools.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://[::1]/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://[::1]/*"
      ],
      "js": [
        "lib/auto-fixer.js",
        "lib/license-manager.js",
        "content/content-script.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected/perception-engine.js",
        "injected/network-interceptor.js",
        "injected/state-recorder.js",
        "injected/framework-decompiler.js",
        "lib/auto-fixer.js",
        "lib/fs-workspace.js",
        "lib/license-manager.js"
      ],
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://[::1]/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "GoA_Rover HUD & Scorecard",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
